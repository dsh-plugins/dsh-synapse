{
  "name": "@dsh-plugin/dsh-synapse",
  "version": "0.1.0",
  "description": "Connect QQ, Discord, and GitHub reviews to DSH",
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README.zh_CN.md",
    "docs",
    "LICENSE",
    "NOTICE.md",
    "scripts",
    "test",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "npm run build && npm run build:client",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "pretest": "npm run build && npm run build:client"
  },
  "peerDependencies": {
    "@dsh-plugin/dsh-loader": "^2.0.0-dev.41617773595"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.4.1",
    "dayjs": "^1.11.19",
    "discord.js": "^14.27.0",
    "gugle-command": "^1.1.17",
    "gugle-event": "^1.1.5",
    "highlight.js": "^11.11.1",
    "jsdom": "^28.1.0",
    "logform": "^2.7.0",
    "markdown-it": "^14.1.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "node-cron": "^4.2.1",
    "puppeteer": "23.2.2",
    "sqlite-vec": "0.1.9",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.41617773595",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "jsdom": "^28.1.0",
    "prettier": "^3.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@dsh-plugin/dsh-loader"
      ]
    }
  },
  "types": "lib/host/index.d.ts",
  "repository": {
    "url": "https://github.com/dsh-plugins/dsh-synapse.git",
    "type": "git"
  },
  "publishConfig": {
    "access": "public"
  }
}
